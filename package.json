{
  "name": "railway",
  "version": "1.0.0",
  "description": "Railway microservices management system",
  "private": true,
  "workspaces": [
    "user-service",
    "notification-service",
    "api-gateway",
    "admin-service"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api-gateway",
    "start": "npm run start --workspace=api-gateway",
    "dev:gateway": "npm run dev --workspace=api-gateway",
    "start:gateway": "npm run start --workspace=api-gateway",
    "dev:user": "npm run dev --workspace=user-service",
    "start:user": "npm run start --workspace=user-service",
    "dev:notification": "npm run dev --workspace=notification-service",
    "start:notification": "npm run start --workspace=notification-service",
    "dev:admin": "npm run dev --workspace=admin-service",
    "start:admin": "npm run start --workspace=admin-service"
  },
